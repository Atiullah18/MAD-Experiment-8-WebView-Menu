<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Title -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Images Fragment"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <!-- Phone Images -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Phone Images (3)"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/phoneImage1"
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:scaleType="centerCrop"
                android:src="@drawable/phone_image_1" />

            <ImageView
                android:id="@+id/phoneImage2"
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:scaleType="centerCrop"
                android:src="@drawable/phone_image_2" />

            <ImageView
                android:id="@+id/phoneImage3"
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:scaleType="centerCrop"
                android:src="@drawable/phone_image_3" />

        </LinearLayout>


        <!-- Storage Images -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Storage Images (3)"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/storageImage1"
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:scaleType="centerCrop"
                android:src="@drawable/storage_image_1" />

            <ImageView
                android:id="@+id/storageImage2"
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:scaleType="centerCrop"
                android:src="@drawable/storage_image_2" />

            <ImageView
                android:id="@+id/storageImage3"
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:scaleType="centerCrop"
                android:src="@drawable/storage_image_3" />

        </LinearLayout>


        <!-- URL Images -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="URL Images (3)"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/urlImage1"
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:scaleType="centerCrop"
                android:src="@drawable/url_image_1" />

            <ImageView
                android:id="@+id/urlImage2"
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:scaleType="centerCrop"
                android:src="@drawable/url_image_2" />

            <ImageView
                android:id="@+id/urlImage3"
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:scaleType="centerCrop"
                android:src="@drawable/url_image_3" />

        </LinearLayout>


        <!-- Image Options -->

        <Button
            android:id="@+id/btnImageOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⋮  Image Options"
            android:layout_marginTop="16dp" />


        <!-- Bottom Share / Edit / Delete -->

        <LinearLayout
            android:id="@+id/bottomActions"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="#512DA8"
            android:visibility="gone">

            <Button
                android:id="@+id/btnShare"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Share"
                android:textColor="@android:color/white"
                android:backgroundTint="#512DA8" />

            <Button
                android:id="@+id/btnEdit"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Edit"
                android:textColor="@android:color/white"
                android:backgroundTint="#512DA8" />

            <Button
                android:id="@+id/btnDelete"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Delete"
                android:textColor="@android:color/white"
                android:backgroundTint="#512DA8" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>